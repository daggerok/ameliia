{
  "name": "ameliia",
  "version": "1.0.0",
  "description": "Math for Ameliia",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf -rf dist",
    "build-github-pages": "bun scripts/build.ts /ameliia/",
    "serve": "parcel --no-cache --no-source-maps",
    "build": "bun scripts/build.ts",
    "start": "pm2 start 'npm run serve' --name app",
    "restart": "pm2 restart app",
    "stop": "pm2 kill",
    "logs": "pm2 logs",
    "test": "bun test tests",
    "dev": "npm run test -- --watch"
  },
  "keywords": [
    "parcel",
    "rimraf",
    "sass",
    "pm2"
  ],
  "author": "Maksim Kostromin / GitHub: daggerok",
  "license": "MIT",
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "2.16.4",
    "@types/bun": "1.4.3",
    "@types/node": "26.0.0",
    "parcel": "2.16.4",
    "pm2": "7.0.1",
    "rimraf": "6.1.3",
    "sass": "1.101.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "4.3.1"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
